# Copy to .env and fill in. Never commit real values.
DATABASE_URL=
# prisma dev / PGlite: use 1. Real PostgreSQL: tune to its connection budget (default 10 if omitted).
DATABASE_POOL_MAX=1
# Optional separate test database; run migrations there before test:integration / test:e2e.
E2E_DATABASE_URL=
APP_URL=http://localhost:3000
# Comma-separated hosts that serve the platform (landing, admin, /s/[slug]).
PLATFORM_HOSTS=localhost:3000,localhost
# >= 32 random chars. Encrypts per-store Mercado Pago tokens.
ENCRYPTION_KEY=
# Allows the one-click "Ver panel del negocio" demo login (demo stores only).
DEMO_LOGIN_ENABLED=true
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=
# BM Dev sales WhatsApp (digits only, with country code).
BMDEV_WHATSAPP=
# Optional: image uploads to Cloudinary (falls back to local /public/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
